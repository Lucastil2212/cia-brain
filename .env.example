# Core
DATA_DIR=/data
NATS_URL=nats://nats:4222
LOG_LEVEL=INFO

# Crawler identity/policy
CRAWLER_USER_AGENT=ManticoreEducationalArchiver/1.0
CRAWLER_CONTACT=
ALLOWED_HOSTS=www.cia.gov,cia.gov
SEED_URLS=https://www.cia.gov/,https://www.cia.gov/readingroom/
CRAWL_DELAY_SECONDS=10
REQUEST_TIMEOUT_SECONDS=90
MAX_RETRIES=5
MAX_DEPTH=40
MAX_FILE_BYTES=0
RECRAWL_AFTER_HOURS=168
MIN_FREE_DISK_GB=5

# Extraction / chunking
OCR_ENABLED=false
OCR_MAX_PAGES=0
CHUNK_CHARS=1800
CHUNK_OVERLAP=240

# Search
EMBEDDING_BACKEND=fastembed
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
OLLAMA_EMBED_MODEL=qwen3-embedding:0.6b
OLLAMA_URL=http://ollama:11434
HYBRID_LEXICAL_WEIGHT=1.0
HYBRID_SEMANTIC_WEIGHT=1.0
RRF_K=60
DEFAULT_TOP_K=12

# Local agent (Docker profile: ai)
LLM_MODEL=qwen3:8b
SEARCH_API_URL=http://api:8080
AGENT_API_URL=http://agent:8090
AGENT_TOP_K=10

# Indexer performance
VECTOR_PERSIST_EVERY=10
PARQUET_COMPACT_EVERY=25
EMBED_BATCH_SIZE=64

# Interval jobs (seconds). Set 0 to disable a job in the built-in scheduler.
# Airflow DAG at dags/cia_brain_etl.py mirrors these tasks.
JOB_RECRAWL_INTERVAL_SECONDS=3600
JOB_PARQUET_COMPACT_INTERVAL_SECONDS=21600
JOB_FRONTIER_SEED_INTERVAL_SECONDS=86400
JOB_HEALTH_INTERVAL_SECONDS=300
SCHEDULER_TICK_SECONDS=5

# Government archive collections; empty disables the additional collections.
ARCHIVE_SOURCES=fbi,nsa,nara,state,odni,dia,crs
# Public API / RSS polling (source-specific intervals); empty disables all feeds.
LIVE_SOURCES=usgs,nws,swpc,goes,nasa,nara_catalog,state_rss,fema_rss,odni_rss
FEED_MAX_BYTES=20000000
GRAPH_ENABLED=true
GRAPH_SPATIAL_RADIUS_KM=250
# Entity extraction: auto (spaCy if installed, else rules) | rules | spacy
GRAPH_NER=auto
# Optional periodic full graph replay (0 = manual only via run-job graph_rebuild).
JOB_GRAPH_REBUILD_INTERVAL_SECONDS=0

# Postgres accounts + rate-limited programmatic API
# Local Compose default is injected on the api service; set here for non-Compose runs.
DATABASE_URL=postgresql://cia:cia@postgres:5432/cia_brain
JWT_SECRET=local-dev-jwt-secret-change-me
AUTH_REQUIRED=false
ALLOW_REGISTRATION=true
API_RATE_LIMIT_PER_MINUTE=60
API_RATE_LIMIT_PER_DAY=5000
ANON_RATE_LIMIT_PER_MINUTE=30
ANON_RATE_LIMIT_PER_DAY=1000
